<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device, neither to cloud backup nor device-to-device transfer.
     The log, settings, PIN hash and the wrapped database key are useless without this device's
     Keystore anyway, and a restored copy would leak that the app was used. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
