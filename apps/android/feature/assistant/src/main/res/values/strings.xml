<resources>
    <string name="assistant_title">Ask Dada</string>
    <string name="assistant_intro">Selam. I’m Dada. Ask me anything about your work, your rights or your health — in your own words. Our conversation is not saved.</string>
    <string name="assistant_input">Type your question…</string>
    <string name="assistant_send">Send</string>
    <string name="assistant_voice">Speak your question</string>
    <string name="assistant_source">Source: %1$s</string>
    <string name="assistant_reviewed_by">Reviewed by %1$s</string>
    <string name="assistant_error">Dada could not answer right now. Check your connection and try again.</string>
    <string name="assistant_retry">Try again</string>
    <string name="assistant_emergency_title">Are you in danger?</string>
    <string name="assistant_emergency_body">If you can, press SOS. It alerts your trusted contact with your location.</string>
    <string name="assistant_open_sos">Open SOS</string>
    <string name="assistant_typing">Dada is writing</string>
    <string name="assistant_offline">You are offline. Dada needs the internet to answer — help numbers and SOS still work without it.</string>
    <string name="assistant_quota">You have asked many questions today. Dada can answer again tomorrow. Help numbers and SOS always work.</string>
    <string name="assistant_call_number">Call %1$s</string>
    <string name="assistant_feedback_question">Was this helpful?</string>
    <string name="assistant_feedback_yes">Yes</string>
    <string name="assistant_feedback_no">No</string>
    <string name="assistant_feedback_thanks">Thank you for telling us.</string>
</resources>
