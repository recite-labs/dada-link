// DadaLink API on Cloudflare Workers.
//
// Local development (no Cloudflare account needed):
//   cp .dev.vars.example .dev.vars
//   pnpm db:migrate:local && pnpm dev
//
// Before deploying, a maintainer must create the resources and replace the
// placeholder ids below (never done by tooling in this repo):
//   wrangler d1 create dadalink            -> d1_databases[0].database_id
//   wrangler kv namespace create RATE_LIMITS -> kv_namespaces[0].id
// and set secrets with `wrangler secret put <NAME>`:
//   DADALINK_HASH_SALT, ANTHROPIC_API_KEY, DADALINK_AI_GATEWAY_TOKEN (optional),
//   TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, AFRICASTALKING_API_KEY.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dadalink-api",
  "main": "src/worker.ts",
  "account_id": "20bea6648f75f8448006ae61a242d850",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dadalink.recitelabs.com", "custom_domain": true }],
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The web app (apps/web) is served from the same origin as the API.
  // Build it first: `pnpm --filter @dadalink/web build`.
  "assets": {
    "directory": "../web/dist",
    // Unknown navigation paths (/am/help/SA) get index.html; the client router takes over.
    "not_found_handling": "single-page-application",
    // API paths always reach the Worker, even for browser navigations (e.g. opening /openapi.json).
    // Keep in sync with apps/web/src/api/paths.ts (checked by apps/web/test/serving.test.ts).
    "run_worker_first": [
      "/health",
      "/openapi.json",
      "/content",
      "/content/*",
      "/directory/*",
      "/agencies/*",
      "/assistant/*",
      "/safety/*",
      "/telegram/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dadalink",
      "database_id": "8c131c55-8453-4dfa-a689-6218e74ec163",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "b74ac6ca19e9426d8aea8f6a50805d24"
    }
  ],
  "vars": {
    "DADALINK_AI_PROVIDER": "anthropic",
    "DADALINK_AI_MODEL": "claude-sonnet-5-5",
    // Cloudflare AI Gateway endpoint for Anthropic, e.g.
    // "https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic"
    "DADALINK_AI_BASE_URL": "https://gateway.ai.cloudflare.com/v1/20bea6648f75f8448006ae61a242d850/dada/anthropic",
    "DADALINK_ASSISTANT_REVIEWED_ONLY": "true",
    "DADALINK_ASSISTANT_DAILY_LIMIT": "30",
    "DADALINK_SMS_PROVIDER": "log",
    "DADALINK_MESSENGER_PROVIDER": "telegram",
    "DADALINK_APP_URL": "https://play.google.com/store/apps/details?id=me.kibru.damakese"
  }
}
