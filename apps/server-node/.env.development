# Safe, offline defaults for `pnpm --filter @dadalink/server-node dev`.
# Override any value in a git-ignored `.env` next to this file.
PORT=3000
DADALINK_DB_FILE=./data/dadalink.db
DADALINK_AI_PROVIDER=fake
DADALINK_HASH_SALT=dev-only-salt-do-not-use-in-production
DADALINK_ASSISTANT_REVIEWED_ONLY=false
DADALINK_SMS_PROVIDER=log
DADALINK_MESSENGER_PROVIDER=log
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

# Built web app (apps/web/dist), served with SPA fallback on the same origin as the API.
DADALINK_WEB_DIR=../web/dist
