# Copy to `.env` (git-ignored) and fill in. Every value is read with Effect Config.
PORT=3000
HOST=127.0.0.1
DADALINK_DB_FILE=./data/dadalink.db
# Comma-separated CORS origins; omit to allow any origin.
# DADALINK_ALLOWED_ORIGINS=https://dadalink.example

# Secret salt for pseudonymising device and chat ids (required).
DADALINK_HASH_SALT=

# Assistant
DADALINK_AI_PROVIDER=anthropic          # anthropic | fake
ANTHROPIC_API_KEY=
DADALINK_AI_MODEL=claude-sonnet-5-5
# Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic
# DADALINK_AI_BASE_URL=
# DADALINK_AI_GATEWAY_TOKEN=
DADALINK_ASSISTANT_REVIEWED_ONLY=true
DADALINK_ASSISTANT_DAILY_LIMIT=30
