{
  "name": "@dadalink/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Drizzle (SQLite/D1) schema, migrations and repositories.",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
